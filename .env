# ===== 模型服务（OpenAI 兼容）=====
# DeepSeek: https://api.deepseek.com/v1
# 硅基流动: https://api.siliconflow.cn/v1
API_BASE=https://api.deepseek.com/v1
API_KEY=sk-xxxxxxxxxxxxxxxx
CHAT_MODEL=deepseek-chat

# ===== 向量模型 =====
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# ===== 重排（可选，留空则跳过）=====
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 检索参数 =====
TOP_K=5
POOL_SIZE=30
# 相关性闸门：最高向量相似度低于该值时直接拒答（0~1，越大越保守）
MIN_SCORE=0.45

# ===== 向量存储 =====
# auto：先探测 Qdrant，连不上自动退到本地文件索引（无需 Docker）
# qdrant / local：强制指定
VECTOR_BACKEND=auto
QDRANT_URL=http://localhost:6333
COLLECTION=handbook

# ===== 数据目录（相对仓库根）=====
RAW_DIR=data/raw
INDEX_DIR=.index
